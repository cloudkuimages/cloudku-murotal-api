{
  "name": "cloudku-murotal",
  "version": "2.0.0",
  "description": "JavaScript client for Murotal API - Islamic prayer times, Quran, Hadith, and Dua",
  "main": "main.cjs",
  "module": "main.mjs",
  "type": "module",
  "exports": {
    ".": {
      "import": "./main.mjs",
      "require": "./main.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test.cjs",
    "test:esm": "node test.mjs",
    "test:quick": "node simple-test.js",
    "test:compat": "node compatibility-test.js",
    "test:all": "npm run test:compat && npm run test && npm run test:esm",
    "test:watch": "nodemon test.cjs"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  },
  "keywords": [
    "murotal",
    "islamic",
    "prayer",
    "quran",
    "hadith",
    "dua",
    "hijri",
    "asmaul-husna"
  ],
  "author": "AlfiDev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudkuimages/cloudku-murotal-api.git"
  },
  "bugs": {
    "url": "https://github.com/cloudkuimages/cloudku-murotal-api/issues"
  },
  "homepage": "https://github.com/cloudkuimages/cloudku-murotal-api#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "browser": "main.mjs"
}